[Unit]
Description=Firmware Audit full security scan
Documentation=file:/opt/firmware-audit/README.md

[Service]
Type=oneshot
User=root
Group=root
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=LANGUAGE=en
ExecStart=/usr/local/bin/firmware-audit-scan --profile full
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=yes
# PrivateDevices is intentionally not enabled: read-only TPM/MSR/IPMI/device evidence is part of the scan.
# PrivateTmp is intentionally not enabled: host /tmp, /var/tmp and /dev/shm are integrity/persistence evidence sources.
# Do not use ProcSubset=pid: the collector reads kernel state from non-process /proc files.
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
# The scanner must read /usr/lib/modules to verify package-owned modules.
# Module load/unload capability remains denied explicitly below.
ProtectKernelModules=no
ProtectKernelLogs=yes
CapabilityBoundingSet=~CAP_SYS_MODULE
SystemCallArchitectures=native
SystemCallFilter=~@module @mount @reboot
RestrictNamespaces=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
UMask=0027
ReadWritePaths=/var/lib/firmware-audit/reports /run/firmware-audit
