# Dashboard listener. Loopback is the safe default.
BIND_HOST=127.0.0.1
BIND_PORT=8088
WEB_WORKERS=2

REPORT_DIR=/var/lib/firmware-audit/reports
STATUS_FILE=/run/firmware-audit/status.json

# Optional HTTP Basic authentication. Both values must be set together.
WEB_USERNAME=
WEB_PASSWORD_HASH=

# Unsafe overrides. Prefer a loopback listener behind an authenticated TLS reverse proxy.
ALLOW_REMOTE_HTTP=false
ALLOW_UNAUTHENTICATED_REMOTE=false

# Manual report upload. The feature is enabled by default. No report is ever uploaded automatically.
# The public receiver validates each submitted Firmware Audit report; no token,
# password, or per-machine upload credential is required. Set this to false to
# hide/disable the manual Upload report action.
UPLOAD_ENABLED=true
UPLOAD_URL=https://audit.telefoncek.si/api/v1/reports
UPLOAD_SOCKET=/run/firmware-audit-uploader/uploader.sock
UPLOAD_TIMEOUT=30
CSRF_SECRET_FILE=/etc/firmware-audit/csrf.key
